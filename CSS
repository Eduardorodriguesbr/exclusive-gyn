.launch-card-title{font-family:var(--serif);font-size:26px;color:var(--text);margin:0;line-height:1.2}
.launch-card-desc{font-size:14px;color:var(--text-mid);line-height:1.6;margin:0}
.launch-card-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:16px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.launch-card-stats > div{text-align:center;font-size:11px;color:var(--text-dim);text-transform:uppercase;letter-spacing:1px;display:flex;flex-direction:column;gap:4px}
.launch-card-stats > div span{font-family:var(--serif);font-size:24px;color:var(--text);font-weight:500;letter-spacing:-0.5px}
.launch-card-footer{display:flex;justify-content:space-between;align-items:center;margin-top:auto}
.launch-price{display:flex;flex-direction:column}
.launch-price-label{font-size:11px;color:var(--text-dim);text-transform:uppercase;letter-spacing:1.2px}
.launch-price-value{font-family:var(--serif);font-size:22px;font-weight:600;letter-spacing:-0.3px;background:linear-gradient(135deg,#b8860b 0%,#d4a012 40%,#e8b923 70%,#f0c030 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-top:2px}
.launch-card-cta{color:#e8b923;font-size:14px;font-weight:500;letter-spacing:.5px}

/* NATIV DETAIL PAGE */
.nativ-gallery{position:relative;background:#0d2a1a;border-radius:var(--radius-lg);overflow:hidden;margin-bottom:14px;margin-top:24px}
.nativ-gal-track{display:flex;transition:transform .4s ease;touch-action:pan-y}
.nativ-gal-track img{flex-shrink:0;width:100%;aspect-ratio:16/9;object-fit:contain;display:block;pointer-events:none;background:#0d2a1a}




.nativ-gal-prev,.nativ-gal-next{display:none}
.nativ-gal-counter{position:absolute;top:14px;right:14px;background:rgba(10,17,23,.8);color:white;padding:6px 14px;border-radius:100px;font-size:12px;letter-spacing:1px;backdrop-filter:blur(10px)}
.nativ-thumbs{display:none}
.nativ-thumbs::-webkit-scrollbar{height:6px}
.nativ-thumbs::-webkit-scrollbar-thumb{background:var(--gold);border-radius:3px}
.nativ-thumb{flex-shrink:0;width:84px;height:56px;border-radius:6px;overflow:hidden;cursor:pointer;border:2px solid transparent;transition:border-color .2s;opacity:.6}
.nativ-thumb.active{border-color:#e8b923;opacity:1}
.nativ-thumb:hover{opacity:1}
.nativ-thumb img{width:100%;height:100%;object-fit:cover}

.nativ-invest-box{background:transparent;border:none;padding:28px 0;margin:28px 0}
.nativ-invest-lbl{font-size:12px;color:var(--text-dim);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:8px}
.nativ-invest-range{font-family:var(--serif);font-size:32px;font-weight:600;letter-spacing:-0.5px;background:linear-gradient(135deg,#b8860b 0%,#d4a012 40%,#e8b923 70%,#f0c030 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:6px;line-height:1.2}
.nativ-invest-range span{font-size:20px;opacity:.6;font-weight:400;margin:0 4px}
.nativ-invest-detail{font-size:14px;color:var(--text-mid);margin-bottom:20px}
.nativ-invest-btn{background:linear-gradient(135deg,#c8960e 0%,#d4a012 35%,#ddb321 65%,#e8b923 100%);border:none;color:#0a1117;font-weight:600;padding:12px 24px;border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;display:inline-flex;align-items:center;gap:10px;transition:all .3s;font-family:var(--sans)}
.nativ-invest-btn:hover{background:linear-gradient(135deg,#d4a012 0%,#ddb321 40%,#e8b923 70%,#f0c030 100%);color:#0a1117;transform:translateY(-1px);box-shadow:0 4px 14px rgba(212,160,18,.4)}

.nativ-timeline{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:24px;margin:28px 0}
.nativ-timeline-title{font-family:var(--serif);font-size:20px;color:var(--text);margin-bottom:18px}
.nativ-timeline-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-bottom:16px}
.nativ-timeline-item{padding:14px;border-radius:8px;background:rgba(255,255,255,.02);border:1px solid var(--border);font-size:13px;color:var(--text-mid);display:flex;flex-direction:column;gap:4px;transition:all .3s}
.nativ-timeline-item span{font-family:var(--serif);font-size:15px;font-weight:600;color:var(--text)}



.nativ-timeline-note{font-size:13px;color:var(--text-dim);font-style:italic;margin:0}

.nativ-about p{font-size:15px;color:var(--text-mid);line-height:1.8;margin-bottom:16px}
.nativ-about p strong{color:var(--text);font-weight:600}
.nativ-rentab{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:24px}
.nativ-rentab-item{text-align:center;padding:20px 14px;background:linear-gradient(135deg,rgba(212,160,18,.08),transparent);border:1px solid rgba(212,160,18,.2);border-radius:12px}
.nativ-rentab-num{display:block;font-family:var(--serif);font-size:36px;font-weight:600;background:linear-gradient(135deg,#b8860b,#e8b923);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;letter-spacing:-1px;margin-bottom:6px}
.nativ-rentab-label{font-size:12px;color:var(--text-mid);line-height:1.5;display:block}

.nativ-sig-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}
.nativ-sig{padding:18px;background:rgba(255,255,255,.02);border:1px solid var(--border);border-radius:10px}
.nativ-sig-role{font-size:11px;color:#e8b923;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:6px}
.nativ-sig-name{font-family:var(--serif);font-size:17px;color:var(--text);font-weight:500;margin-bottom:3px}
.nativ-sig-person{font-size:13px;color:var(--text-dim)}

.nativ-typo-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px}
.nativ-typo{padding:18px;background:rgba(255,255,255,.02);border:1px solid var(--border);border-radius:10px;transition:all .3s}
.nativ-typo:hover{border-color:#e8b923;background:rgba(212,160,18,.04)}
.nativ-typo-size{font-family:var(--serif);font-size:24px;color:var(--text);font-weight:600;margin-bottom:4px;letter-spacing:-0.5px}
.nativ-typo-name{font-size:13px;color:var(--text-mid);margin-bottom:12px}
.nativ-typo-price{font-size:17px;font-weight:600;background:linear-gradient(135deg,#b8860b,#e8b923);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:4px}
.nativ-typo-units{font-size:11px;color:var(--text-dim);text-transform:uppercase;letter-spacing:1px}

.nativ-lazer-block{margin-bottom:20px}
.nativ-lazer-title{font-family:var(--serif);font-size:16px;color:#e8b923;margin-bottom:12px;padding-left:12px;border-left:2px solid #e8b923}
.nativ-lazer-items{display:flex;flex-wrap:wrap;gap:8px}
.nativ-lazer-items span{padding:6px 14px;background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:100px;font-size:13px;color:var(--text-mid)}

.nativ-pillars{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px}
.nativ-pillar{padding:22px;background:rgba(255,255,255,.02);border:1px solid var(--border);border-radius:12px}
.nativ-pillar-icon{font-size:28px;margin-bottom:10px}
.nativ-pillar-title{font-family:var(--serif);font-size:18px;color:var(--text);margin-bottom:12px;font-weight:500}
.nativ-pillar ul{list-style:none;padding:0;margin:0}
.nativ-pillar ul li{padding:6px 0 6px 18px;position:relative;font-size:13px;color:var(--text-mid);line-height:1.5}
.nativ-pillar ul li::before{content:'';position:absolute;left:0;top:13px;width:6px;height:6px;border-radius:50%;background:#e8b923}

.nativ-ficha{border:1px solid var(--border);border-radius:10px;overflow:hidden;background:rgba(255,255,255,.02)}
.nativ-ficha-row{display:grid;grid-template-columns:180px 1fr;padding:12px 18px;border-bottom:1px solid var(--border);font-size:14px;color:var(--text-mid);align-items:start;gap:14px}
.nativ-ficha-row:last-child{border-bottom:none}
.nativ-ficha-row span{color:#e8b923;font-size:11px;text-transform:uppercase;letter-spacing:1.3px;font-weight:500;padding-top:3px}
.nativ-disclaimer{font-size:11px;color:var(--text-dim);font-style:italic;line-height:1.6;margin-top:14px;padding:14px;background:rgba(255,255,255,.02);border-radius:8px;border-left:2px solid var(--border)}

/* PRICE LIGHTBOX */
.price-lightbox{display:none;position:fixed;inset:0;background:rgba(5,8,13,.95);z-index:9999;align-items:center;justify-content:center;backdrop-filter:blur(12px)}
.price-lightbox.open{display:flex}
.price-lightbox-inner{position:relative;max-width:90vw;max-height:90vh;display:flex;align-items:center;justify-content:center}
.price-lightbox-inner img{max-width:90vw;max-height:85vh;width:auto;height:auto;object-fit:contain;border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,.6)}
.price-lightbox-close{position:absolute;top:-48px;right:0;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:white;width:40px;height:40px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .3s}
.price-lightbox-close:hover{background:rgba(212,160,18,.8);border-color:#e8b923}
.price-lightbox-prev,.price-lightbox-next{position:absolute;top:50%;transform:translateY(-50%);background:rgba(10,17,23,.6);border:1px solid rgba(255,255,255,.2);color:white;width:54px;height:54px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .3s}
.price-lightbox-prev{left:-72px}
.price-lightbox-next{right:-72px}
.price-lightbox-prev:hover,.price-lightbox-next:hover{background:rgba(212,160,18,.9);border-color:#e8b923}
.price-lightbox-counter{position:absolute;bottom:-42px;left:50%;transform:translateX(-50%);background:rgba(10,17,23,.8);color:white;padding:7px 18px;border-radius:100px;font-size:13px;letter-spacing:1.5px;white-space:nowrap}

@media(max-width:768px){
.nativ-rentab{grid-template-columns:1fr}
.nativ-rentab-num{font-size:30px}
.nativ-ficha-row{grid-template-columns:1fr;gap:4px}
.nativ-invest-range{font-size:24px}
.nativ-invest-range span{font-size:16px}
.launch-banner{padding:56px 20px 48px}
.launch-grid{grid-template-columns:1fr;gap:20px}



.price-lightbox-prev{left:8px;width:44px;height:44px}
.price-lightbox-next{right:8px;width:44px;height:44px}
.price-lightbox-close{top:12px;right:12px}
.nativ-lazer-items span{font-size:12px;padding:5px 11px}
}
