:root{
--gold:#d4a012;--gold-light:#e8d5a0;--gold-dark:#9a7a32;--gold-glow:rgba(212,160,18,.15);
--emerald:#1fab72;--emerald-deep:#0d7a4a;--emerald-glow:rgba(31,171,114,.12);
--copper:#c27c50;--copper-light:#e8b08a;
--bg:#0e1117;--bg-card:#161a22;--bg-card-hover:#1c2028;--bg-elevated:#1e222b;
--surface:#ffffff0a;--surface-hover:#ffffff12;
--text:#e8e8e8;--text-mid:#a8a8a8;--text-dim:#6a7080;
--border:#ffffff14;--border-hover:#ffffff24;
--header-bg:rgba(14,17,23,.94);
--card-shadow:0 24px 80px rgba(0,0,0,.2),0 0 0 1px rgba(212,160,18,.1);
--serif:'Playfair Display',Georgia,serif;
--sans:'Outfit',system-ui,sans-serif;
--radius:8px;--radius-lg:13px;--radius-xl:21px;--radius-xxl:34px;--phi:1.618;--space-xs:5px;--space-sm:8px;--space-md:13px;--space-lg:21px;--space-xl:34px;--space-2xl:55px;--space-3xl:89px;--space-4xl:144px;
}
html.light{
--gold:#a07830;--gold-light:#d4a012;--gold-dark:#7a5a20;--gold-glow:rgba(160,120,48,.1);
--emerald:#0d8a52;--emerald-deep:#065a32;--emerald-glow:rgba(13,138,82,.08);
--copper:#a06038;--copper-light:#c88060;
--bg:#f5f2ed;--bg-card:#ffffff;--bg-card-hover:#faf8f4;--bg-elevated:#ffffff;
--surface:#00000008;--surface-hover:#0000000f;
--text:#1a1714;--text-mid:#5a5550;--text-dim:#9a958e;
--border:#00000012;--border-hover:#00000022;
--header-bg:rgba(245,242,237,.9);
--card-shadow:0 20px 60px rgba(0,0,0,.06),0 0 0 1px rgba(160,120,48,.08);
}
.toggle-wrap{display:flex;align-items:center;gap:8px;margin-right:8px}
.toggle-label{font-size:13px;color:var(--text-dim);letter-spacing:1.2px;text-transform:uppercase;user-select:none}
.toggle-track{width:52px;height:28px;border-radius:14px;background:var(--surface);border:1px solid var(--border);cursor:pointer;position:relative;transition:all .35s}
.toggle-track:hover{border-color:#e8b923}
.toggle-thumb{width:22px;height:22px;border-radius:50%;background:linear-gradient(135deg,#c8960e 0%,#d4a012 35%,#ddb321 65%,#e8b923 100%);position:absolute;top:2px;left:2px;transition:all .35s cubic-bezier(.34,1.56,.64,1);display:flex;align-items:center;justify-content:center}
html.light .toggle-thumb{left:26px}
.toggle-thumb svg{width:12px;height:12px}
html:not(.light) .sun-icon{display:none}
html.light .moon-icon{display:none}
html.light .s1 .slide-bg{background-image:url('https://lh3.googleusercontent.com/d/14TqOuHg-dqWAikA4nOfRdW-KCyB7z6PV=s1920');background-size:cover;background-position:center;background-repeat:no-repeat}
html.light .s2 .slide-bg{background-image:url('https://lh3.googleusercontent.com/d/1wFY2R2krH2xHcwDg7G8ysHePu4gw9WMy=s1920');background-size:cover;background-position:center;background-repeat:no-repeat}
html.light .s3 .slide-bg{background-image:url('https://lh3.googleusercontent.com/d/1n6IupIOidGdmfLFZe_z7KtDO7ZBwmBCq=s1920');background-size:cover;background-position:center;background-repeat:no-repeat}
html.light .slide-decor::before{border-color:rgba(212,160,18,.12)}
html.light .slide-decor::after{border-color:rgba(212,160,18,.08)}
html.light .slide-title{color:#ffffff}
html.light .slide-title span{color:var(--gold-light)}
html.light .slide-sub{color:rgba(255,255,255,.6)}
html.light .slide-tag{color:var(--gold-light);border-color:rgba(212,160,18,.4)}
html.light .slide-btn{color:#0c0e12}
html.light .nav-cta{color:#fff!important}
html.light .acta-btn{color:#fff}
html.light .dcta{background:linear-gradient(135deg,#0a1628,#142238,#0d2a1a)}
html.light .dcta h3{color:#ffffff}
html.light .dcta p{color:rgba(255,255,255,.6)}
html.light .pc-img svg{stroke:rgba(255,255,255,.2)}
html.light .dgallery svg{stroke:rgba(255,255,255,.15)}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;overflow-x:hidden;width:100%}
body{font-family:var(--sans);background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased;overflow-x:hidden;width:100%;transition:background .4s,color .4s}

.ticker-bar{background:linear-gradient(135deg,#c8960e 0%,#d4a012 35%,#ddb321 65%,#e8b923 100%);overflow:hidden;white-space:nowrap;position:relative;height:28px;display:flex;align-items:center}
.ticker-track{display:inline-block;animation:tickerScroll 35s linear infinite}
.ticker-text{font-size:11px;font-weight:500;color:#ffffff;letter-spacing:1.5px;text-transform:uppercase;font-family:var(--sans)}
@keyframes tickerScroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
.header{position:sticky;top:0;z-index:100;background:var(--header-bg);backdrop-filter:blur(24px) saturate(1.4);border-bottom:1px solid var(--border);transition:background .4s;width:100%}
.header-inner{max-width:987px;margin:0 auto;padding:0 28px;display:flex;align-items:center;justify-content:space-between;height:89px;gap:13px;position:relative}
.logo{display:flex;align-items:center;text-decoration:none;cursor:pointer;flex-shrink:0}
.logo-img{height:68px;width:auto;transition:transform .3s cubic-bezier(.34,1.56,.64,1);filter:brightness(1)}
.logo:hover .logo-img{transform:scale(1.05)}
html.light .logo-img{filter:invert(1)}
html.light .footer-logo{filter:invert(1)}
nav{display:flex;align-items:center;gap:28px;flex-shrink:1;flex-wrap:nowrap;position:absolute;left:50%;transform:translateX(-50%)}
.header-right{display:flex;align-items:center;gap:21px;flex-shrink:0}
nav a{font-size:16px;font-weight:400;color:var(--text-mid);text-decoration:none;letter-spacing:1.3px;text-transform:uppercase;transition:color .25s;cursor:pointer;position:relative}
nav a:hover,nav a.on{color:var(--gold)}
nav a.on::after{content:'';position:absolute;bottom:-6px;left:0;right:0;height:2px;background:var(--gold);border-radius:1px}
.nav-cta{background:linear-gradient(135deg,#c8960e 0%,#d4a012 35%,#ddb321 65%,#e8b923 100%);color:var(--bg)!important;padding:8px 24px;border-radius:8px;font-weight:500;letter-spacing:1.3px;text-transform:uppercase;font-size:13px;transition:all .25s;border:none;cursor:pointer}
.nav-cta:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(212,160,18,.25)}
.nav-cta::after{display:none!important}

.carousel{position:relative;width:100%;height:61.8vh;overflow:hidden;margin:0;padding:0}
.carousel-slides{display:flex;width:300%;height:100%;transition:transform .8s cubic-bezier(.4,0,.15,1)}
.carousel-slide{width:calc(100%/3);height:100%;position:relative;flex-shrink:0;display:flex;align-items:center;justify-content:center}
.slide-bg{position:absolute;top:0;left:0;right:0;bottom:0;width:100%;height:100%}
.s1 .slide-bg{background-image:url('https://lh3.googleusercontent.com/d/14TqOuHg-dqWAikA4nOfRdW-KCyB7z6PV=s1920');background-size:cover;background-position:center;background-repeat:no-repeat}
.s2 .slide-bg{background-image:url('https://lh3.googleusercontent.com/d/1wFY2R2krH2xHcwDg7G8ysHePu4gw9WMy=s1920');background-size:cover;background-position:center;background-repeat:no-repeat}
.s3 .slide-bg{background-image:url('https://lh3.googleusercontent.com/d/1n6IupIOidGdmfLFZe_z7KtDO7ZBwmBCq=s1920');background-size:cover;background-position:center;background-repeat:no-repeat}
.slide-decor{position:absolute;inset:0;overflow:hidden}
.slide-decor::before{content:'';position:absolute;top:-50%;right:-20%;width:600px;height:600px;border-radius:50%;border:1px solid rgba(212,160,18,.08)}
.slide-decor::after{content:'';position:absolute;bottom:-30%;left:-10%;width:400px;height:400px;border-radius:50%;border:1px solid rgba(212,160,18,.05)}
.slide-content{position:relative;z-index:2;text-align:center;padding:0 40px;max-width:720px}
.slide-tag{display:inline-block;font-size:13px;letter-spacing:3.4px;text-transform:uppercase;color:var(--gold);border:1px solid rgba(212,160,18,.3);padding:8px 22px;margin-bottom:21px;font-weight:500}
.slide-title{font-family:var(--serif);font-size:53px;font-weight:500;color:var(--text);line-height:1.12;margin-bottom:13px;letter-spacing:-0.5px}
.slide-title span{color:var(--gold)}
.slide-sub{font-size:16px;color:var(--text-mid);line-height:1.61818;margin-bottom:21px;font-weight:300}
.slide-btn{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,#c8960e 0%,#d4a012 35%,#ddb321 65%,#e8b923 100%);color:var(--bg);padding:13px 32px;border-radius:8px;font-size:13px;font-weight:500;letter-spacing:1.3px;text-transform:uppercase;text-decoration:none;transition:all .25s;border:none;cursor:pointer}
.slide-btn:hover{transform:translateY(-2px);box-shadow:0 12px 40px rgba(212,160,18,.3)}
.c-dots{position:absolute;bottom:28px;left:50%;transform:translateX(-50%);display:flex;gap:13px;z-index:10}
.c-dot{width:36px;height:3px;border-radius:2px;background:rgba(255,255,255,.15);cursor:pointer;transition:all .35s;border:none}
.c-dot.on{background:var(--gold);width:56px}
.c-arrows{display:none !important}
.c-arrow{pointer-events:all;width:48px;height:48px;border-radius:50%;background:rgba(255,255,255,.05);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.1);color:var(--text-mid);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .25s}
.c-arrow:hover{background:rgba(212,160,18,.15);border-color:rgba(212,160,18,.3);color:var(--gold)}

.main{max-width:987px;margin:0 auto;padding:56px 28px 100px}
.stag{font-size:13px;letter-spacing:3.4px;text-transform:uppercase;color:var(--gold);font-weight:500;margin-bottom:8px}
.stitle{font-family:var(--serif);font-size:42px;font-weight:500;color:var(--text);letter-spacing:-0.5px}

.search-wrap{position:relative;margin-bottom:21px;display:flex;gap:8px;align-items:stretch}
.search-wrap input{flex:1;padding:13px 20px 16px 48px;border-radius:var(--radius);border:1px solid var(--border);font-size:16px;color:var(--text);background:var(--bg-card);font-family:var(--sans);transition:all .25s}
.search-wrap input::placeholder{color:var(--text-dim)}
.search-wrap input:focus{outline:none;border-color:#e8b923;box-shadow:0 0 0 4px var(--gold-glow)}
.search-wrap svg{position:absolute;left:18px;top:50%;transform:translateY(-50%);color:var(--text-dim)}
.search-btn{background:linear-gradient(135deg,#c8960e 0%,#d4a012 35%,#ddb321 65%,#e8b923 100%);color:var(--bg);border:none;padding:0 28px;border-radius:var(--radius);font-family:var(--sans);font-size:16px;font-weight:600;letter-spacing:1.3px;text-transform:uppercase;cursor:pointer;transition:all .25s;white-space:nowrap}
.search-btn:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(212,160,18,.25)}

.filters{margin-bottom:34px}
.ftypes{display:flex;gap:13px;flex-wrap:nowrap;margin-bottom:13px;overflow-x:auto;padding:6px 2px 10px;overflow-y:visible}
.fp{display:flex;flex-direction:column;align-items:center;gap:6px;padding:13px 16px;border-radius:var(--radius);font-size:13px;font-weight:400;cursor:pointer;border:1px solid var(--border);color:var(--text-mid);background:transparent;transition:all .35s cubic-bezier(.4,0,.15,1);letter-spacing:.3px;min-width:72px;flex-shrink:0}
.fp:hover{border-color:#e8b923;color:var(--gold);transform:translateY(-3px);box-shadow:0 8px 24px rgba(212,160,18,.1)}
.fp.on{border-color:#e8b923;color:var(--gold);background:transparent;font-weight:500;transform:translateY(-4px);box-shadow:0 10px 30px rgba(212,160,18,.15)}
.fp.on .fp-icon{filter:none}
.fp-icon{width:48px;height:48px;object-fit:contain;transition:all .35s}
.fsel-row{display:flex;gap:8px;flex-wrap:wrap;padding:4px 0}
.fs{padding:13px 18px;border-radius:var(--radius);border:1px solid var(--border);font-size:16px;color:var(--text-mid);background:transparent;cursor:pointer;font-family:var(--sans);transition:all .35s cubic-bezier(.4,0,.15,1);-webkit-appearance:none}
.fs:hover{border-color:#e8b923;color:var(--gold);transform:translateY(-3px);box-shadow:0 8px 24px rgba(212,160,18,.1)}
.fs option{background:var(--bg-card);color:var(--text)}
.fs:focus{outline:none;border-color:#e8b923;box-shadow:0 0 0 4px var(--gold-glow);transform:translateY(-3px)}
.rcount{font-size:16px;color:var(--text-dim);margin-bottom:21px}

.pgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:21px}
.pc{border-radius:var(--radius-lg);overflow:hidden;background:var(--bg-card);border:1px solid var(--border);cursor:pointer;transition:all .4s cubic-bezier(.4,0,.15,1);opacity:0;animation:cardIn .5s ease-out forwards}
.pc:hover{transform:translateY(-8px);border-color:#e8b923;box-shadow:0 20px 50px rgba(212,160,18,.15),0 0 0 1px rgba(212,160,18,.2)}
.pc:nth-child(1){animation-delay:.05s}.pc:nth-child(2){animation-delay:.1s}.pc:nth-child(3){animation-delay:.15s}.pc:nth-child(4){animation-delay:.2s}.pc:nth-child(5){animation-delay:.25s}.pc:nth-child(6){animation-delay:.3s}
@keyframes cardIn{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
.pc-img{height:38.2vh;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center}
.pc-img::after{content:'';position:absolute;bottom:0;left:0;right:0;height:80px;background:linear-gradient(transparent,rgba(0,0,0,.4))}
.pbadge{position:absolute;top:14px;left:14px;z-index:2;font-size:13px;font-weight:600;padding:5px 12px;border-radius:6px;letter-spacing:1.2px;text-transform:uppercase}
.pbadge-new{background:var(--emerald);color:white}
.pbadge-oport{background:var(--gold);color:var(--bg)}
.pbadge-dest{background:linear-gradient(135deg,#3a6bcc,#2a4a9a);color:white}
.pbadge-reserv{background:var(--copper);color:white}
.pc-body{padding:21px 22px 22px}
.pc-type{font-size:13px;font-weight:600;color:var(--emerald);text-transform:uppercase;letter-spacing:2.1px;margin-bottom:8px}
.pc-title{font-family:var(--serif);font-size:21px;font-weight:500;color:var(--text);margin-bottom:13px;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pc-feats{display:flex;gap:13px;font-size:13px;color:var(--text-dim);margin-bottom:13px;padding-bottom:16px;border-bottom:1px solid var(--border)}
.pc-feats span{display:flex;align-items:center;gap:5px}
.pc-price{font-size:26px;font-weight:600;letter-spacing:-0.3px;background:linear-gradient(135deg,#b8860b 0%,#d4a012 40%,#e8b923 70%,#f0c030 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.pc-m2{font-size:13px;color:var(--text-dim);margin-top:3px}

.detail,.about{display:none}
.dback{display:inline-flex;align-items:center;gap:8px;font-size:16px;color:var(--text-dim);cursor:pointer;margin-bottom:21px;transition:color .2s}
.dback:hover{color:var(--gold)}
.dgallery{border-radius:var(--radius-xl);overflow:hidden;margin-bottom:16px;position:relative;height:400px;display:flex;align-items:center;justify-content:center}

.dbadges span{backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
.dbadges{display:flex;gap:8px;margin-bottom:12px}
.dbadges span{font-size:12px;font-weight:600;color:white;padding:5px 12px;border-radius:6px;letter-spacing:1.2px;text-transform:uppercase}
.dheader{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:28px;gap:24px}
.dmeta{font-size:13px;font-weight:600;color:var(--emerald);text-transform:uppercase;letter-spacing:2.1px;margin-bottom:6px}
.dtitle{font-family:var(--serif);font-size:34px;font-weight:500;color:var(--text);margin-bottom:6px;line-height:1.2}
.daddr{font-size:15px;color:var(--text-dim);display:flex;align-items:center;gap:5px}
.dprice-box{text-align:right;flex-shrink:0;display:flex;flex-direction:column;align-items:flex-end;justify-content:center}
.dprice-lbl{font-size:12px;color:var(--text-dim);text-transform:uppercase;letter-spacing:2.1px;margin-bottom:4px}
.dprice{font-size:32px;font-weight:600;letter-spacing:-0.5px;background:linear-gradient(135deg,#b8860b 0%,#d4a012 40%,#e8b923 70%,#f0c030 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.dpm2{font-size:13px;color:var(--text-dim);margin-top:2px}
.wbtn-top{display:inline-flex;align-items:center;gap:8px;background:#25D366;color:white;padding:10px 20px;border-radius:var(--radius);font-size:13px;font-weight:500;cursor:pointer;border:none;text-decoration:none;transition:all .3s;margin-top:12px}
.wbtn-top:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(37,211,102,.3)}
.dstats{display:grid;gap:12px;margin-bottom:28px}
.dst{background:var(--bg-card);border-radius:var(--radius);padding:16px 12px;text-align:center;border:1px solid var(--border)}
.dst-v{font-size:24px;font-weight:600;color:var(--text);margin-top:6px}
.dst-l{font-size:10px;color:var(--text-dim);text-transform:uppercase;letter-spacing:1.3px;margin-top:3px;line-height:1.4}
.dsection{margin-bottom:28px}
.dstitle{font-family:var(--serif);font-size:26px;font-weight:500;color:var(--text);margin-bottom:13px}
.ddesc{font-size:16px;color:var(--text-mid);line-height:1.61818}
.dtags{display:flex;flex-wrap:wrap;gap:8px}
.dtags span{padding:8px 16px;border-radius:100px;border:1px solid var(--border);font-size:13px;color:var(--text-mid);transition:all .2s}
.dtags span:hover{border-color:#e8b923;color:var(--gold)}
.dmap{height:200px;background:var(--bg-card);border-radius:var(--radius-lg);border:1px solid var(--border);display:flex;flex-direction:column;align-items:center;justify-content:center;margin-bottom:34px}
.dcta{background:linear-gradient(135deg,#0a1628,#142238,#0d2a1a);border-radius:var(--radius-xl);padding:34px;display:flex;align-items:center;justify-content:space-between;margin-bottom:34px;gap:24px;border:1px solid rgba(212,160,18,.1)}
.dcta h3{font-family:var(--serif);font-size:26px;font-weight:500;color:#ffffff;margin-bottom:6px}
.dcta p{font-size:16px;color:rgba(255,255,255,.6)}
.wbtn{display:inline-flex;align-items:center;gap:8px;background:#25D366;color:white;padding:13px 32px;border-radius:var(--radius);font-size:16px;font-weight:500;cursor:pointer;border:none;text-decoration:none;transition:all .25s;flex-shrink:0}
.wbtn:hover{transform:scale(1.04);box-shadow:0 12px 36px rgba(37,211,102,.3)}

.dgallery-wrap{margin-bottom:21px}
.dgallery-main{overflow:hidden;position:relative;width:100%;max-width:700px;margin:0 auto;border-radius:var(--radius-lg);overflow:hidden}
.dgallery-main img#galMain{display:block;max-width:100%;max-height:70vh;height:auto;margin:0 auto;border-radius:var(--radius-lg);transition:opacity .3s}
.gal-arrow{position:absolute;top:50%;transform:translateY(-50%);width:44px;height:44px;border-radius:50%;background:rgba(0,0,0,.55);backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.15);cursor:pointer;display:flex;align-items:center;justify-content:center;opacity:.85;transition:all .2s;z-index:2}
.gal-arrow:hover{opacity:1;background:rgba(0,0,0,.75);transform:translateY(-50%) scale(1.08)}
.gal-arrow-l{left:12px}
.gal-arrow-r{right:12px}

.dgal-track{display:flex;transition:transform .4s ease;touch-action:pan-y}
.dgal-slide{flex-shrink:0;width:100%;height:auto;object-fit:contain;display:block;pointer-events:none}

.dgallery-thumbs{display:none}
.gal-arrow,.gal-arrow-l,.gal-arrow-r{display:none !important}
.gal-counter{position:absolute;top:12px;right:12px;background:rgba(0,0,0,.55);backdrop-filter:blur(6px);border-radius:100px;padding:6px 16px;color:white;font-size:13px;font-weight:500;letter-spacing:1.2px;z-index:2}
.dgallery-thumbs{display:flex;gap:8px;margin-top:10px;overflow-x:auto;padding-bottom:6px;scrollbar-width:thin;max-width:700px;margin-left:auto;margin-right:auto}
.dgallery-thumbs::-webkit-scrollbar{height:4px}
.dgallery-thumbs::-webkit-scrollbar-thumb{background:var(--gold);border-radius:2px}
.gal-thumb{width:72px;height:52px;object-fit:cover;border-radius:8px;cursor:pointer;opacity:.5;transition:all .25s;border:2px solid transparent;flex-shrink:0}
.gal-thumb:hover{opacity:.8}
.gal-thumb.on{opacity:1;border-color:#e8b923}

.ideal-banner{position:relative;width:100%;height:38.2vh;overflow:hidden;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#0a1628 0%,#142238 30%,#1a3050 50%,#0d2a1a 80%,#0a1e14 100%)}
.ideal-banner-overlay{position:absolute;inset:0;background:url('') center/cover no-repeat;opacity:.3;z-index:0}
.ideal-banner::before{content:'';position:absolute;top:-60%;right:-10%;width:500px;height:500px;border-radius:50%;border:1px solid rgba(212,160,18,.08);z-index:1}
.ideal-banner::after{content:'';position:absolute;bottom:-40%;left:-5%;width:350px;height:350px;border-radius:50%;border:1px solid rgba(212,160,18,.06);z-index:1}
