function simularFinanc(){
  var valRaw=document.getElementById('simVal').value.replace(/\D/g,'');
  var entRaw=document.getElementById('simEnt').value.replace(/\D/g,'');
  var val=parseFloat(valRaw)||0;
  var ent=parseFloat(entRaw)||0;
  var prazo=parseInt(document.getElementById('simPrazo').value);
  var banco=document.getElementById('simBanco').value;
  var sistema=document.getElementById('simSistema').value;
  var renda=parseFloat((document.getElementById('simRenda').value||'').replace(/\D/g,''))||0;
  var idadeVal=document.getElementById('simIdade').value;var idade=idadeVal?parseInt(idadeVal):35;

  if(!val||val<50000){alert('Informe o valor do imóvel');return}
  if(!banco){alert('Selecione um banco');return}
  if(ent>=val){alert('A entrada não pode ser maior que o valor do imóvel');return}

  var bk=BANK_RATES[banco];
  var financ=val-ent;
  var maxFinanc=val*(bk.maxFinanc/100);
  if(financ>maxFinanc){
    alert('Entrada mínima de '+(100-bk.maxFinanc)+'% para o '+bk.name+'. Mínimo: R$ '+(val-maxFinanc).toLocaleString('pt-BR'));
    return;
  }

  var idadeFinal=idade+(prazo/12);
  if(idadeFinal>80){
    var prazoMax=(80-idade)*12;
    alert('Prazo máximo para sua idade: '+prazoMax+' meses ('+Math.floor(prazoMax/12)+' anos). A idade final não pode ultrapassar 80 anos.');
    return;
  }

  var taxaAnual=bk.taxa;
  var taxaMensal=Math.pow(1+taxaAnual/100,1/12)-1;
  var n=prazo;

  // Seguros obrigatórios (valores aproximados reais)
  // MIP (Morte e Invalidez): varia com idade - aproximação real
  var mipTaxa;
  if(idade<=30)mipTaxa=0.0145;
  else if(idade<=35)mipTaxa=0.0195;
  else if(idade<=40)mipTaxa=0.0280;
  else if(idade<=45)mipTaxa=0.0420;
  else if(idade<=50)mipTaxa=0.0620;
  else if(idade<=55)mipTaxa=0.0890;
  else if(idade<=60)mipTaxa=0.1250;
  else mipTaxa=0.1700;

  // DFI (Danos Físicos ao Imóvel): ~0.0080% do valor do imóvel por mês
  var dfiMensal=val*0.000080;

  // Taxa de administração mensal
  var txAdmin=25;

  var primParcela,ultParcela,totalPago,parcelas=[];

  if(sistema==='sac'){
    var amort=financ/n;
    for(var i=0;i<n;i++){
      var saldoDev=financ-(amort*i);
      var juros=saldoDev*taxaMensal;
      var mip=saldoDev*(mipTaxa/100);
      var parcTotal=amort+juros+mip+dfiMensal+txAdmin;
      parcelas.push({amort:amort,juros:juros,mip:mip,dfi:dfiMensal,admin:txAdmin,total:parcTotal,saldo:saldoDev-amort});
    }
    primParcela=parcelas[0].total;
    ultParcela=parcelas[n-1].total;
    totalPago=ent;
    for(var i=0;i<n;i++)totalPago+=parcelas[i].total;
  }else{
    // Price - parcela base fixa (amort+juros)
    var parcelaBase=financ*(taxaMensal*Math.pow(1+taxaMensal,n))/(Math.pow(1+taxaMensal,n)-1);
    for(var i=0;i<n;i++){
      var saldoDev=financ;
      if(i>0){
        // Calcula saldo devedor progressivo no Price
        saldoDev=financ*Math.pow(1+taxaMensal,i)-parcelaBase*((Math.pow(1+taxaMensal,i)-1)/taxaMensal);
      }
      if(saldoDev<0)saldoDev=0;
      var mip=saldoDev*(mipTaxa/100);
      var parcTotal=parcelaBase+mip+dfiMensal+txAdmin;
      parcelas.push({base:parcelaBase,mip:mip,dfi:dfiMensal,admin:txAdmin,total:parcTotal,saldo:saldoDev});
    }
    primParcela=parcelas[0].total;
    ultParcela=parcelas[n-1].total;
    totalPago=ent;
    for(var i=0;i<n;i++)totalPago+=parcelas[i].total;
  }

  // Total de juros
  var totalJuros=totalPago-val;
  var totalSeguros=0;
  for(var i=0;i<n;i++)totalSeguros+=parcelas[i].mip+parcelas[i].dfi+parcelas[i].admin;

  // Comprometimento de renda
  var compRenda=renda>0?((primParcela/renda)*100):0;
  var compClass=compRenda>30?'#e74c3c':compRenda>25?'var(--gold)':'var(--emerald)';

  // CET aproximado (Custo Efetivo Total)
