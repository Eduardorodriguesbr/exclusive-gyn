/* URL ROUTING */
function slugify(t){return t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'')}
function routeFromURL(){
var p=window.location.pathname;
if(p==='/lancamentos')showLancamentos(true);
else if(p==='/nativ')showNativ(true);
else if(p==='/sobre')showAbout(true);
else if(p==='/sob-medida')showIdeal(true);
else if(p==='/privacidade'){if(typeof showPrivacy==='function')showPrivacy(true)}
else if(p.indexOf('/imovel/')===0){var slug=p.replace('/imovel/','');var found=null;for(var i=0;i<D.length;i++){if(slugify(D[i].tt)===slug){found=D[i];break}}if(found)showD(found.id,true);else showList(true)}
else if(p.indexOf('/artigo/')===0){var aslug=p.replace('/artigo/','');if(ART_IDS[aslug])showArticle(ART_IDS[aslug],true);else showList(true)}
else showList(true);
}
window.addEventListener('popstate',routeFromURL);
routeFromURL();


