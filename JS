var plantIdx=0;
function openPlantLightbox(){plantIdx=0;updatePlantLightbox();document.getElementById('plantLightbox').classList.add('open');document.body.style.overflow='hidden'}
function closePlantLightbox(){document.getElementById('plantLightbox').classList.remove('open');document.body.style.overflow=''}
function closePlantLightboxBg(e){if(e.target.id==='plantLightbox')closePlantLightbox()}
function updatePlantLightbox(){document.getElementById('plantLightboxImg').src=NATIV_PLANTS[plantIdx];document.getElementById('plantLightboxCounter').textContent=(plantIdx+1)+' / '+NATIV_PLANTS.length}
function plantPrev(){plantIdx=(plantIdx-1+NATIV_PLANTS.length)%NATIV_PLANTS.length;updatePlantLightbox()}
function plantNext(){plantIdx=(plantIdx+1)%NATIV_PLANTS.length;updatePlantLightbox()}
